{
  "version": 2,
  "_note": "Small semantic obligation set. Route-execution and behavioral tests prove loading and consistency; these matchers prevent accidental removal of critical rules.",
  "claims": [
    { "id": "skill.gates.four", "file": "skill/SKILL.md", "match": "deterministic floor.*verifier judgment.*plan review.*user approval", "obligation": "all four stages run in order" },
    { "id": "skill.gates.blocking", "file": "skill/SKILL.md", "match": "Only BLOCKING findings block", "obligation": "NITs and observations never block" },
    { "id": "skill.profile.first", "file": "skill/SKILL.md", "match": "profile before creating files", "obligation": "artifact necessity is profiled before planning" },
    { "id": "skill.survey.writer", "file": "skill/SKILL.md", "match": "Exactly one named writer", "obligation": "the survey map has one writer" },
    { "id": "skill.profile.single", "file": "skill/SKILL.md", "match": "MEDIUM/LARGE use only `answers\\.yaml\\.plan_profile`", "obligation": "MEDIUM/LARGE have one machine profile" },
    { "id": "skill.route.phases", "file": "skill/SKILL.md", "match": "archgen_refs\\{action:'route'", "obligation": "references load by phase" },
    { "id": "skill.worker.capability", "file": "skill/SKILL.md", "match": "unknown.*unreadable.*dispatchable:false", "obligation": "capability failure blocks dispatch" },
    { "id": "skill.install.admin", "file": "skill/SKILL.md", "match": "archgen_setup\\{action:'install_skill'", "obligation": "skill installation is admin-only" },
    { "id": "skill.tracking.local", "file": "skill/SKILL.md", "match": "Install manifests.*local state", "obligation": "local state is not committed plan state" },
    { "id": "skill.failure.wait", "file": "skill/SKILL.md", "match": "never auto-retry|no automatic retry", "obligation": "failed tasks wait for the user" },

    { "id": "standards.host", "file": "skill/references/code-standards.md", "match": "host repository's toolchain", "obligation": "host conventions take precedence" },
    { "id": "standards.loc", "file": "skill/references/code-standards.md", "match": "Soft limit.*1000 LOC", "obligation": "file size is a soft review trigger" },
    { "id": "standards.colocated", "file": "skill/references/code-standards.md", "match": "host-native colocation is valid and needs no waiver", "obligation": "host-native colocated tests need no waiver" },
    { "id": "standards.acceptance", "file": "skill/references/code-standards.md", "match": "objectively verifiable", "obligation": "acceptance is objectively verifiable" },

    { "id": "interview.unresolved", "file": "packages/mcp/assets/references/interview.md", "match": "unresolved", "obligation": "interviews ask only unresolved forks" },
    { "id": "interview.round0", "file": "packages/mcp/assets/references/interview.md", "match": "Round 0", "obligation": "scope calibration precedes discovery" },
    { "id": "interview.answers", "file": "packages/mcp/assets/references/interview.md", "match": "answers\\.yaml", "obligation": "answers have a machine-readable record" },
    { "id": "interview.nfr", "file": "packages/mcp/assets/references/interview.md", "match": "every measurable NFR has a numeric target", "obligation": "only measurable NFRs require numeric targets" },

    { "id": "orchestration.floor", "file": "packages/mcp/assets/references/orchestration.md", "match": "The floor comes FIRST", "obligation": "the deterministic floor precedes judgment" },
    { "id": "orchestration.rounds", "file": "packages/mcp/assets/references/orchestration.md", "match": "No Round 3", "obligation": "review stages have at most two rounds by default" },
    { "id": "orchestration.survey", "file": "packages/mcp/assets/references/orchestration.md", "match": "Exactly one named writer", "obligation": "survey writing cannot overlap" },
    { "id": "orchestration.fallback", "file": "packages/mcp/assets/references/orchestration.md", "match": "main agent executes sequentially", "obligation": "native execution falls back to sequential self-execution" },
    { "id": "orchestration.failure", "file": "packages/mcp/assets/references/orchestration.md", "match": "never auto-retry", "obligation": "failed tasks are not automatically retried" },

    { "id": "artifacts.reuse", "file": "packages/mcp/assets/references/artifact-templates.md", "match": "separate create/augment decision", "obligation": "reuse and authored deltas are distinct decisions" },
    { "id": "artifacts.ownership", "file": "packages/mcp/assets/references/artifact-templates.md", "match": "same-wave overlap is BLOCKING", "obligation": "same-wave ownership overlap blocks" },
    { "id": "artifacts.profile", "file": "packages/mcp/assets/references/artifact-templates.md", "match": "MEDIUM / LARGE.*answers\\.yaml", "obligation": "MEDIUM/LARGE profile lives in answers.yaml" },
    { "id": "artifacts.local", "file": "packages/mcp/assets/references/artifact-templates.md", "match": "Local-only.*install-manifest", "obligation": "install records are local-only" },
    { "id": "artifacts.nfr", "file": "packages/mcp/assets/references/artifact-templates.md", "match": "Measurable NFRs need numeric targets", "obligation": "non-measurable NFRs may name controls" },

    { "id": "platform.unknown", "file": "packages/mcp/assets/references/platforms.md", "match": "Unknown platform|official docs MCP configuration", "obligation": "unknown platforms require official documentation" },
    { "id": "platform.index", "file": "packages/mcp/assets/references/platforms.md", "match": "empty `\\.codegraph/` directory does not", "obligation": "an empty directory is not an index" },
    { "id": "platform.explore", "file": "packages/mcp/assets/references/platforms.md", "match": "defaults CodeGraph to `codegraph_explore`", "obligation": "explore is the default CodeGraph surface" },

    { "id": "skills.approval", "file": "packages/mcp/assets/references/mcp-and-skills.md", "match": "Full-profile admin only, after explicit user approval", "obligation": "installation requires explicit user approval" },
    { "id": "skills.install", "file": "packages/mcp/assets/references/mcp-and-skills.md", "match": "archgen_setup \\{ action: 'install_skill'", "obligation": "skill installation uses the admin tool" },
    { "id": "skills.compliance", "file": "packages/mcp/assets/references/mcp-and-skills.md", "match": "ONE line PER REQUIRED SKILL", "obligation": "every required skill gets a compliance line" },

    { "id": "gate.class", "file": "packages/mcp/assets/briefs/_gate-protocol.md", "match": "every finding carries exactly one class", "obligation": "every finding has one classification" },
    { "id": "gate.rounds", "file": "packages/mcp/assets/briefs/_gate-protocol.md", "match": "AT MOST TWICE", "obligation": "a gate runs at most twice by default" },
    { "id": "gate.nit", "file": "packages/mcp/assets/briefs/_gate-protocol.md", "match": "NIT.*NEVER blocks", "obligation": "NITs never block approval" },

    { "id": "verifier.floor", "file": "packages/mcp/assets/briefs/verifier.md", "match": "THE FLOOR IS ALREADY COMPUTED", "obligation": "verifiers consume rather than recompute the floor" },
    { "id": "verifier.fingerprint", "file": "packages/mcp/assets/briefs/verifier.md", "match": "fingerprint", "obligation": "stale brief snapshots are rejected" },
    { "id": "verifier.scope", "file": "packages/mcp/assets/briefs/verifier.md", "match": "SCOPE & ARTIFACT NECESSITY", "obligation": "artifact necessity is judged" },

    { "id": "review.areas", "file": "packages/mcp/assets/briefs/review.md", "match": "EXAMINE ALL 5 AREAS", "obligation": "all five review areas are covered" },
    { "id": "review.class", "file": "packages/mcp/assets/briefs/review.md", "match": "\\[BLOCKING\\]", "obligation": "review examples classify findings" },
    { "id": "review.table", "file": "packages/mcp/assets/briefs/review.md", "match": "MANDATORY COVERAGE TABLE", "obligation": "every review includes a coverage table" },

    { "id": "survey.writer", "file": "packages/mcp/assets/briefs/survey.md", "match": "ONE NAMED WRITER", "obligation": "survey has exactly one map writer" },
    { "id": "survey.sections", "file": "packages/mcp/assets/briefs/survey.md", "match": "six non-empty sections", "obligation": "the survey carries all six sections" },
    { "id": "survey.toolchain", "file": "packages/mcp/assets/briefs/survey.md", "match": "Toolchain", "obligation": "the survey records the host toolchain" },

    { "id": "investigate.root", "file": "packages/mcp/assets/briefs/investigate.md", "match": "ROOT CAUSE", "obligation": "investigation starts with root cause" },
    { "id": "investigate.sizing", "file": "packages/mcp/assets/briefs/investigate.md", "match": "1 investigator by default", "obligation": "investigation uses one agent by default" },
    { "id": "investigate.reuse", "file": "packages/mcp/assets/briefs/investigate.md", "match": "CONTINUE THIS AGENT'S SESSION", "obligation": "analysis sessions continue for evidence follow-ups" }
  ]
}
