{
  "name": "archgen-skill",
  "version": "0.1.5",
  "description": "Architecture generation & autonomous task execution for coding agents - conversational requirements in, dependency-ordered tasks out, executed wave-by-wave with verifier gates. Works with Claude Code, OpenCode, Cursor, Codex, Gemini CLI and any agentskills.io harness.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "archgen-skill": "bin/archgen.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "vendor/",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "agents",
    "claude",
    "codex",
    "cursor",
    "opencode",
    "gemini",
    "architecture",
    "skills",
    "orchestration",
    "task-graph",
    "planning"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akashmaurya99/archgen.git"
  },
  "homepage": "https://github.com/akashmaurya99/archgen#readme",
  "bugs": {
    "url": "https://github.com/akashmaurya99/archgen/issues"
  },
  "//": "vendor/skills/archgen is a full mirror of ../../skill synced by scripts/sync-vendor.mjs (run automatically via prepublishOnly).",
  "scripts": {
    "sync:config": "node scripts/sync-config.mjs",
    "sync:check": "node scripts/sync-config.mjs --check && node scripts/sync-vendor.mjs --check",
    "sync": "node scripts/sync-config.mjs && node scripts/sync-vendor.mjs",
    "prepublishOnly": "node scripts/sync-config.mjs && node scripts/sync-vendor.mjs",
    "test": "ARCHGEN_CODEGRAPH=0 node --test test/*.test.mjs"
  }
}
