# Dependencies
node_modules/

# A nested node_modules INSIDE a package is never legitimate. The CLI is
# zero-dependency and the MCP server resolves its own deps from its own
# package.json, so a nested copy can only be a stray `npm install` run in the
# wrong directory. It is worse than clutter: Node resolves it BEFORE the
# package's real node_modules, so a stale copy of archgen-mcp silently wins
# over the current one. (A v0.1.3 copy sat under packages/cli/lib/ while the
# repo was at v0.1.7.) structure-lint fails the build if one appears.
packages/*/lib/node_modules/
packages/*/src/node_modules/
packages/*/bin/node_modules/

# Logs
*.log

# macOS
.DS_Store

# Local agent workspace (.omo) — ignored entirely
.omo/

# Build artifacts
dist/
coverage/

# Worktrees
.worktrees/

# Deploy-time version stamp: init/install write .archgen-version into INSTALLED
# trees only; sync-vendor prunes it from the npm payload. Never track it in
# vendor/ (the CLI test suite recreates it there as a side effect).
packages/cli/vendor/skills/archgen/.archgen-version

# CodeGraph indexes are local machine state — never commit them
.codegraph/

# Legacy VS Code extension runtime state inside .archgen/.runtime/ — a
# heartbeat and the command acknowledgements the extension used to write.
# Nothing writes it any more (the extension and its bridge are gone), but a
# machine that still has an old extension installed would otherwise dirty
# `git status` here. Safe to delete the directory.
.archgen/.runtime/

# The CLI is zero-dependency and deliberately ships NO lockfile. CI's audit job
# generates one in the workspace only to resolve the dependency tree; it must
# never be committed, or a transitive bump would land in the repo unnoticed.
packages/cli/package-lock.json

# `npm link` in packages/cli drops a symlink here that points at the GLOBALLY
# installed archgen-mcp. It is machine-local, it dangles in a clean clone, and
# it is not part of the published payload (the CLI publishes bin/archgen.mjs).
packages/cli/bin/archgen-mcp
