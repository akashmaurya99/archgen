# Dependencies
node_modules/

# Logs
*.log

# macOS
.DS_Store

# Local agent workspace (.omo) — ignored entirely
.omo/

# Build artifacts
*.vsix
dist/
coverage/

# Worktrees
.worktrees/

# Deploy-time version stamp: init/install write .archgen-version into INSTALLED
# trees only; sync-vendor prunes it from the npm payload. Never track it in
# vendor/ (the CLI test suite recreates it there as a side effect).
packages/cli/vendor/skills/archgen/.archgen-version

# CodeGraph indexes are local machine state — never commit them
.codegraph/

# The VS Code extension's runtime state inside .archgen/.runtime/ — a heartbeat
# and the command acknowledgements. Machine state, like the index above: it
# changes on every run and belongs to the machine, not to the repository.
.archgen/.runtime/

# The CLI is zero-dependency and deliberately ships NO lockfile. CI's audit job
# generates one in the workspace only to resolve the dependency tree; it must
# never be committed, or a transitive bump would land in the repo unnoticed.
packages/cli/package-lock.json
